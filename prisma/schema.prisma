// =============================================================================
// Camproxi Unified Prisma Schema — MongoDB
// =============================================================================
// Merged from: Admin Portal, Agent Portal, Student Portal
// All models share a single MongoDB database (camproxi).
// =============================================================================

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ADMIN PORTAL — Types & Models
// =============================================================================

type SchoolLocation {
  longitude Float
  latitude  Float
}

enum AdminRole {
  OFFICIAL
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

type Campus {
  name     String
  location SchoolLocation
}

model Admin {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  username String    @unique
  email    String    @unique
  name     String?
  password String
  role     AdminRole @default(OFFICIAL)

  schoolId   String? @db.ObjectId
  school     School? @relation(fields: [schoolId], references: [id])
  campusName String?

  createdAt DateTime @default(now())

  auditLogs       AuditLog[]
  assignedReports Report[]

  resetOtp       String?
  resetOtpExpiry DateTime?

  @@map("admins")
}

model School {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  code       String?
  campus     Campus[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  agents     Agent[]
  users      User[]
  properties Property[]
  products   Product[]
  services   Service[]
  admins     Admin[]

  @@map("schools")
}

// =============================================================================
// AGENT PORTAL — Types & Models
// =============================================================================

enum AgentCategory {
  AGENT
  VENDOR
  SERVICE_PROVIDER
}

type AgentProfileImage {
  url      String
  publicId String @map("public_id")
}

type SocialLinks {
  facebook  String @default("")
  twitter   String @default("")
  instagram String @default("")
}

model Agent {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  username       String             @unique
  companyName    String
  category       AgentCategory      @default(AGENT)
  email          String             @unique
  password       String
  phone          String
  whatsapp       String?
  profileImage   AgentProfileImage?
  address        String?
  bio            String             @default("")
  socialLinks    SocialLinks?
  schoolId       String             @db.ObjectId
  school         School             @relation(fields: [schoolId], references: [id])
  campusName     String
  isverified     Boolean            @default(false)
  emailVerified  Boolean            @default(false)
  phoneVerified  Boolean            @default(false)
  emailOtp       String?
  emailOtpExpiry DateTime?
  phoneOtp       String?
  phoneOtpExpiry DateTime?
  resetOtp       String?
  resetOtpExpiry DateTime?
  isSuspended    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  products   Product[]
  services   Service[]
  chats      Chat[]

  stores         Store[]
  serviceWorkers ServiceWorker[]

  @@index([schoolId])
  @@map("agents")
}

type Location {
  lat Float
  lng Float
}

type PriceRange {
  min Float
  max Float
}

type OperatingHours {
  open  String // e.g. "09:00"
  close String // e.g. "17:00"
}

model Store {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId        String          @db.ObjectId
  agent          Agent           @relation(fields: [agentId], references: [id])
  
  name           String
  description    String?
  bannerImage    String?
  address        String?
  location       Location?
  operatingHours OperatingHours?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  @@map("stores")
}

model ServiceWorker {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  agentId        String       @db.ObjectId
  agent          Agent        @relation(fields: [agentId], references: [id])
  
  name           String
  kindOfService  String
  profileImage   String?
  phone          String?
  whatsapp       String?
  socialLinks    SocialLinks?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  @@map("service_workers")
}

type PropertyImage {
  url      String
  publicId String   @map("public_id")
  isCover  Boolean?
}

model Property {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String
  name         String
  address      String
  roomType     String
  amenities    String[]
  description  String
  price        Float
  unitQuantity Int
  location     Location
  images       PropertyImage[]

  campus  String
  agentId String @db.ObjectId
  agent   Agent  @relation(fields: [agentId], references: [id])

  isVacant     Boolean  @default(true)
  status       String   @default("pending")
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School?  @relation(fields: [schoolId], references: [id])
  schoolId     String?  @db.ObjectId

  averageRating Float @default(0.0)
  totalReviews  Int   @default(0)

  @@index([status, schoolId])
  @@index([agentId])
  @@index([campus, isVacant])
  @@map("properties")
}

enum DeliveryOption {
  CAMPUS
  PICKUP
  HOME
}

type Delivery {
  option   DeliveryOption? @default(HOME)
  price    Float?
  duration Int?
}

type ProductImage {
  url      String
  publicId String   @map("public_id")
  isCover  Boolean?
}

model Product {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  productId        String
  name             String
  businessCategory String
  delivery         Delivery?
  description      String
  price            Float
  images           ProductImage[]

  campus  String
  agentId String @db.ObjectId
  agent   Agent  @relation(fields: [agentId], references: [id])

  isAvailable  Boolean  @default(true)
  status       String   @default("pending")
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School?  @relation(fields: [schoolId], references: [id])
  schoolId     String?  @db.ObjectId

  averageRating Float @default(0.0)
  totalReviews  Int   @default(0)

  @@index([status, schoolId])
  @@index([agentId])
  @@index([campus, isAvailable])
  @@map("products")
}

type TimeRange {
  startTime String
  endTime   String
}

type ServiceImage {
  url      String
  publicId String   @map("public_id")
  isCover  Boolean?
}

model Service {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  serviceId       String
  name            String
  address         String
  serviceCategory String
  availableDays   String[]
  description     String
  price           Float
  perUnit         String
  time            TimeRange
  images          ServiceImage[]
  campus          String

  agentId String @db.ObjectId
  agent   Agent  @relation(fields: [agentId], references: [id])

  isAvailable  Boolean  @default(true)
  status       String   @default("pending")
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School?  @relation(fields: [schoolId], references: [id])
  schoolId     String?  @db.ObjectId

  averageRating Float @default(0.0)
  totalReviews  Int   @default(0)

  @@index([status, schoolId])
  @@index([agentId])
  @@index([campus, isAvailable])
  @@map("services")
}

// =============================================================================
// STUDENT PORTAL — Types & Models
// =============================================================================

type UserLocation {
  longitude Float
  latitude  Float
}

type NotificationSettings {
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  orders       Boolean @default(true)
  promotions   Boolean @default(true)
  security     Boolean @default(true)
}

type UserProfileImage {
  url       String
  public_id String
}

model SavedItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId       String
  itemCategory String
  savedAt      DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @db.ObjectId
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  username       String    @unique
  password       String
  email          String    @unique
  phone          String?
  isverified     Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  emailOtp       String?
  emailOtpExpiry DateTime?
  phoneOtp       String?
  phoneOtpExpiry DateTime?
  resetOtp       String?
  resetOtpExpiry DateTime?
  isSuspended    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  location UserLocation?

  schoolId   String @db.ObjectId
  school     School @relation(fields: [schoolId], references: [id])
  campusName String

  bio                  String?
  profileImage         UserProfileImage?
  notificationSettings NotificationSettings?
  pushTokens           String[]

  saveditems SavedItem[]
  reviews    Review[]
  ratings    Rating[]
  requests   Request[]
  chats      Chat[]

  notificationsEnabled Boolean @default(true)

  @@unique([id, email])
  @@index([schoolId])
  @@map("users")
}

// =============================================================================
// GLOBAL — Notifications
// =============================================================================

enum RecipientType {
  STUDENT
  AGENT
  ADMIN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationCat {
  REVIEW_CREATED
  REQUEST_UPDATED
  REQUEST_CREATED
  NEW_MESSAGE
  ACCOUNT_VERIFIED
  ITEM_VERIFIED
  ITEM_REJECTED
  REPORT_REPLIED
}

model Notification {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId   String           @db.ObjectId
  recipientType RecipientType
  title         String
  message       String
  type          NotificationType @default(INFO)
  isRead        Boolean          @default(false)
  category      NotificationCat

  link         String?
  itemId       String? @db.ObjectId
  itemCategory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

// =============================================================================
// GLOBAL — Reports & Support
// =============================================================================

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ReportTargetType {
  AGENT
  STUDENT
  ITEM
  GENERAL
}

model Report {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  subject      String
  message      String
  reporterId   String        @db.ObjectId
  reporterType RecipientType // STUDENT or AGENT
  status       ReportStatus  @default(OPEN)

  targetType   ReportTargetType @default(GENERAL)
  targetId     String?          @db.ObjectId // ID of the Agent, Student, or Item
  itemCategory String? // "PRODUCT", "PROPERTY", or "SERVICE"

  reply       String?
  repliedById String? @db.ObjectId

  assignedToId String? @db.ObjectId
  assignedTo   Admin?  @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
}

// =============================================================================
// GLOBAL — Ratings & Reviews
// =============================================================================

model Rating {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId       String   @db.ObjectId
  itemCategory String // "PRODUCT", "PROPERTY", "SERVICE"
  rating       Int // 1 to 5
  studentId    String   @db.ObjectId
  student      User     @relation(fields: [studentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, itemId])
  @@index([itemId, itemCategory])
  @@map("ratings")
}

model Review {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  itemId       String @db.ObjectId
  itemCategory String // "PRODUCT", "PROPERTY", "SERVICE"
  comment      String
  studentId    String @db.ObjectId
  student      User   @relation(fields: [studentId], references: [id])

  agentReply     String?
  agentRepliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId, itemCategory])
  @@map("reviews")
}

// =============================================================================
// GLOBAL — Requests
// =============================================================================

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Request {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  itemId        String        @db.ObjectId
  itemCategory  String // "PRODUCT", "PROPERTY", "SERVICE"
  itemName      String
  studentId     String        @db.ObjectId
  student       User          @relation(fields: [studentId], references: [id])
  message       String?
  status        RequestStatus @default(PENDING)
  agentResponse String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@map("requests")
}

// =============================================================================
// GLOBAL — Chat System
// =============================================================================

model Chat {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String  @db.ObjectId
  student      User    @relation(fields: [studentId], references: [id])
  agentId      String  @db.ObjectId
  agent        Agent   @relation(fields: [agentId], references: [id])
  itemId       String? @db.ObjectId // Optional reference to what they are discussing
  itemCategory String? // "PRODUCT", "PROPERTY", "SERVICE"

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([studentId, agentId, itemId])
  @@map("chats")
}

enum SenderType {
  STUDENT
  AGENT
}

model Message {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  chatId     String     @db.ObjectId
  chat       Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId   String     @db.ObjectId
  senderType SenderType
  content    String
  isRead     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([chatId, createdAt])
  @@map("messages")
}

// =============================================================================
// GLOBAL — Admin Audit & Settings
// =============================================================================

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String   @db.ObjectId
  admin     Admin    @relation(fields: [adminId], references: [id])
  action    String
  details   String? // JSON stringified payload of the action
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String // JSON stringified value
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}